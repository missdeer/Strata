# Generated, not source: deterministic build products of tools/ (see docs/).
# tiny-qwen4exp.gguf is ~113 MB, over GitHub's 100 MB file limit -- regenerate with
#   python tools/make_tiny_model.py
bench/tiny-*.gguf
bench/wide-*.gguf
bench/micro/*.exe
bench/micro/*.obj
bench/micro/*.bin
bench/micro/*.dll
bench/micro/*.txt
*.log
build*/
pack/
logs/
__pycache__/
.pytest_cache/
*.pyc

# plan v0.3 P1 (repository hygiene, review E1): profiler captures and large diagnostic dumps stay out of git.
*.nsys-rep

# Pi harness metadata (local session state, not project source)
*.sqlite
*.npz
*.occ1
td.log

# created by setup.py on the user's machine
/.venv/
/build/
/third_party/llama.cpp
/models/
/packs/
/mtp/
/run-*.bat
/run-*.sh
/strata-*.json
/strata-*.log
/build-strata.bat
/build-strata-cuda12.bat
/build-cuda12/
/.strata-mcp/

# image encoder (setup.py --vision): build output and the generated build script
build-vision*/
build-vision.bat
build-vision-cuda12.bat

# setup.py outputs (engine, downloads) and release builds
/engine/
/engine-cuda12/
/build-release*/
/dist/
*.done
/third_party/*.zip

# IDEs
.vscode/
.idea/
.cursor/

/.ccache/
/.rocm-win/

# Local SDK downloads, generated smoke binaries and cluster credentials.
/tmp/hip-pip-cache/
/tmp/cluster-hip-preflight/
/tmp/cluster-hip-build/
/tmp/*.exe*
/tmp/dual-host-test/*.key
/tmp/dual-host-test/*.pid
/tmp/commit_message.txt

# Native text migration build/test dependencies and generated parity reports.
/tmp/jsoncons-source/
/tmp/jsoncons-v1.7.0.zip
/tmp/native-text-test-deps/
/tmp/native-text-parity*.json
/tmp/strata-native-text-*/
/tmp/build-native-text*.cmd

# Local native cluster build/package verification; never ship these fixtures.
/tmp/stage5*/
/tmp/stage5-*.json
/tmp/build-stage5*.cmd
/tmp/verify-stage5-*.py

# Stage 6 local packages, source transfer archives, temporary configs and drivers.
/tmp/stage6/
/tmp/stage6-*.py
/tmp/stage6-*.cmd
/tmp/stage6-known-hosts

# Keep local build drivers under version control, but ignore build products.
!/build/
/build/*
!/build/README.md
!/build/*.cmd
!/build/*.py
!/build/*.hip
