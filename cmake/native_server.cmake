function(strata_add_native_server llama_root)
  get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  find_package(Threads REQUIRED)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/native_images.cmake")
  strata_add_image_codecs()
  add_library(strata_http_vendor STATIC "${llama_root}/vendor/cpp-httplib/httplib.cpp")
  target_include_directories(strata_http_vendor SYSTEM PUBLIC "${llama_root}/vendor/cpp-httplib")
  target_link_libraries(strata_http_vendor PUBLIC Threads::Threads)
  if(WIN32)
    target_link_libraries(strata_http_vendor PUBLIC ws2_32 crypt32)
  endif()
  add_library(strata_cluster_runtime STATIC
    "${_root}/src/runtime/cluster_config.cpp" "${_root}/src/runtime/expert_store.cpp"
    "${_root}/src/runtime/cluster_launch.cpp" "${llama_root}/vendor/hash/sha256/sha256.c")
  target_include_directories(strata_cluster_runtime PUBLIC "${_root}/include")
  target_include_directories(strata_cluster_runtime SYSTEM PUBLIC "${llama_root}/vendor")
  target_include_directories(strata_cluster_runtime SYSTEM PRIVATE "${llama_root}/vendor/hash/sha256" "${llama_root}/vendor/hash")
  target_link_libraries(strata_cluster_runtime PUBLIC strata_kernels_cpu Threads::Threads)
  if(WIN32)
    target_link_libraries(strata_cluster_runtime PRIVATE advapi32 ws2_32)
  endif()
  add_library(strata_server_runtime STATIC
    "${_root}/src/runtime/engine_process.cpp" "${_root}/src/runtime/engine_channel.cpp" "${_root}/src/runtime/server_engine.cpp" "${_root}/src/runtime/server_api.cpp"
    "${_root}/src/runtime/server_state.cpp" "${_root}/src/runtime/server_telemetry.cpp" "${_root}/src/runtime/server_batch.cpp" "${_root}/src/runtime/native_http.cpp" "${_root}/src/runtime/server_mcp.cpp" "${_root}/src/runtime/server_vision.cpp" "${_root}/src/runtime/server_security.cpp" "${_root}/src/runtime/server_config.cpp" "${_root}/src/runtime/server_metrics.cpp" "${_root}/src/runtime/server_recovery.cpp"
    "${_root}/src/runtime/native_image.cpp" "${llama_root}/vendor/hash/sha256/sha256.c")
  target_include_directories(strata_server_runtime SYSTEM PRIVATE "${llama_root}/vendor/hash/sha256" "${llama_root}/vendor/hash" "${llama_root}/vendor/stb")
  set_source_files_properties("${_root}/src/runtime/server_recovery.cpp" PROPERTIES INCLUDE_DIRECTORIES "${llama_root}/src")
  target_link_libraries(strata_server_runtime PUBLIC strata_text_runtime strata_cluster_runtime Threads::Threads ${CMAKE_DL_LIBS} PRIVATE strata_image_codecs)
  if(WIN32)
    target_link_libraries(strata_server_runtime PRIVATE advapi32 winhttp windowscodecs ole32 uuid ws2_32 pdh)
  else()
    find_package(CURL REQUIRED)
    find_package(PNG REQUIRED)
    target_link_libraries(strata_server_runtime PRIVATE CURL::libcurl PNG::PNG)
  endif()
  if(TARGET strata_warnings)
    target_link_libraries(strata_server_runtime PRIVATE strata_warnings)
  endif()
  add_executable(strata-host "${_root}/src/program/host.cpp" "${_root}/src/program/server.cpp"
    "${_root}/src/program/cluster.cpp" "${_root}/src/program/network_worker.cpp")
  target_link_libraries(strata-host PRIVATE strata_server_runtime strata_http_vendor)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/native_vision.cmake")
  strata_add_native_vision("${llama_root}")
  configure_file("${llama_root}/vendor/cpp-httplib/LICENSE" "${CMAKE_BINARY_DIR}/native-text-licenses/cpp-httplib-LICENSE.txt" COPYONLY)
  if(STRATA_BUILD_TESTS)
    add_executable(strata-cluster-test-role "${_root}/tests/runtime/cluster_test_role.cpp")
    target_link_libraries(strata-cluster-test-role PRIVATE strata_cluster_runtime)
    add_library(strata-network-test-backend SHARED "${_root}/tests/runtime/network_test_backend.cpp")
    target_include_directories(strata-network-test-backend PRIVATE "${_root}/include")
    target_compile_definitions(strata-network-test-backend PRIVATE _CRT_SECURE_NO_WARNINGS)
    add_executable(strata-server-test-engine "${_root}/tests/runtime/server_test_engine.cpp")
    add_executable(strata-server-batch-test-engine "${_root}/tests/runtime/server_batch_test_engine.cpp")
    add_executable(strata-mcp-test-server "${_root}/tests/runtime/mcp_test_server.cpp")
    add_executable(strata-vision-test-encoder "${_root}/tests/runtime/vision_test_encoder.cpp")
    add_executable(strata-server-check "${_root}/src/program/server_check.cpp")
    target_link_libraries(strata-server-check PRIVATE strata_server_runtime)
    target_include_directories(strata-mcp-test-server SYSTEM PRIVATE "${llama_root}/vendor")
    find_package(Python3 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
      add_test(NAME native_server_parity COMMAND "${Python3_EXECUTABLE}" "${_root}/tools/test_native_server.py"
        --exe $<TARGET_FILE:strata-host> --engine $<TARGET_FILE:strata-server-test-engine>)
      set_tests_properties(native_server_parity PROPERTIES TIMEOUT 300)
    endif()
  endif()
endfunction()
